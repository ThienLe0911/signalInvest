# ==============================================================================
# signalInvest - Environment Variables Configuration Template
# ==============================================================================
# QUAN TRỌNG VỀ BẢO MẬT:
# 1. KHÔNG BAO GIỜ commit file .env.local hoặc bất kỳ file chứa API key thật nào lên Git.
# 2. KHÔNG thêm tiền tố NEXT_PUBLIC_ vào các biến bí mật (GEMINI_API_KEY).
# 3. Khi chạy Local:
#    - Sao chép file này thành .env.local: cp .env.example .env.local
#    - Điền khóa API thực tế vào .env.local
# 4. Khi triển khai Vercel:
#    - Thêm các biến này trong Vercel Dashboard: Project Settings > Environment Variables
# ==============================================================================

# [BẮT BUỘC ĐỂ KÍCH HOẠT TÍNH NĂNG AI INSIGHTS]
# Khóa API Google Gemini từ Google AI Studio (https://aistudio.google.com/)
# Lưu ý: Luôn để trống trong file mẫu. Không bao giờ commit khóa thật vào Git.
# Nếu để trống khi ứng dụng vận hành, hệ thống sẽ tự động chuyển sang chế độ phân tích fallback an toàn.
GEMINI_API_KEY=

# [TÙY CHỌN] Mô hình Gemini sử dụng
# Các mô hình khuyến nghị:
# - gemini-2.5-flash : Tốc độ phản hồi nhanh, ổn định, tương thích tối đa Serverless Functions (khuyến nghị cho Vercel)
# - gemini-3.7-flash : Khả năng suy luận mở rộng và phân tích chuyên sâu
GEMINI_MODEL=gemini-2.5-flash

# [TÙY CHỌN] Bật tính năng tìm kiếm tin tức thị trường thực tế qua Google Search grounding (true / false)
# Giá trị mặc định: true
GEMINI_ENABLE_GOOGLE_SEARCH=true

# [DỰ PHÒNG TƯƠNG LAI] Khóa dịch vụ dữ liệu thị trường trả phí (hiện tại chưa dùng)
# Hệ thống hiện đang lấy dữ liệu trực tiếp qua Yahoo Finance, Binance và VNDIRECT Dchart.
# MARKET_DATA_PROVIDER_KEY=
